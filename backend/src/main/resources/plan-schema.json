{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["tasks"],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["outlineNodeId", "plannedDate", "estimatedMinutes"],
        "additionalProperties": false,
        "properties": {
          "outlineNodeId": { "type": "string", "format": "uuid" },
          "plannedDate": { "type": "string", "format": "date" },
          "estimatedMinutes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
