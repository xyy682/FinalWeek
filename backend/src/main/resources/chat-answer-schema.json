{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["answer", "sourceSegmentIds", "generalKnowledgeSupplement"],
  "additionalProperties": false,
  "properties": {
    "answer": { "type": "string", "minLength": 1 },
    "sourceSegmentIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
    "generalKnowledgeSupplement": { "type": ["string", "null"] }
  }
}
