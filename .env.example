# Application
SPRING_PROFILES_ACTIVE=docker
APP_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
AUTH_CODE_TTL_MINUTES=10
AUTH_SEND_COOLDOWN_SECONDS=60
AUTH_RATE_WINDOW_MINUTES=10
AUTH_MAX_SENDS_PER_WINDOW=5
AUTH_MAX_VERIFY_ATTEMPTS=5
UPLOAD_CHUNK_SIZE=8MB
UPLOAD_CLEANUP_INTERVAL_MINUTES=15

# MySQL
MYSQL_DATABASE=finalweek
MYSQL_USER=finalweek
MYSQL_PASSWORD=finalweek_dev_password
MYSQL_ROOT_PASSWORD=finalweek_root_password
MYSQL_HOST_PORT=3306

# Redis / RabbitMQ
REDIS_HOST_PORT=6379
RABBITMQ_DEFAULT_USER=finalweek
RABBITMQ_DEFAULT_PASS=finalweek_dev_password

# MinIO
MINIO_ROOT_USER=finalweek
MINIO_ROOT_PASSWORD=finalweek_dev_password
MINIO_BUCKET=finalweek
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
PREVIEW_URL_TTL_MINUTES=10

# First-version configurable defaults
COURSE_LIMIT=8
UPLOAD_TTL_HOURS=24
DOCUMENT_MAX_SIZE_MB=100
MEDIA_MAX_SIZE_MB=2048
MEDIA_MAX_DURATION_MINUTES=120
PARSE_USER_RATE_PER_MINUTE=30
PARSE_GLOBAL_RATE_PER_MINUTE=120
TASK_EXCHANGE=finalweek.tasks
TASK_ROUTING_KEY=parse
TASK_QUEUE=finalweek.parse
TASK_DLX=finalweek.tasks.dlx
TASK_DLQ=finalweek.parse.dlq
TASK_CONFIRM_TIMEOUT_SECONDS=5
TASK_STALE_PENDING_SECONDS=30
TASK_STALE_SCAN_SECONDS=30
TASK_PROCESSING_LEASE_SECONDS=300
TASK_LEASE_HEARTBEAT_SECONDS=30
TASK_PROGRESS_TTL_HOURS=24
TASK_MAX_DELIVERY_ATTEMPTS=3
TASK_CONSUMER_CONCURRENCY=2
TASK_CONSUMER_MAX_CONCURRENCY=4
PLAN_USER_RATE_PER_MINUTE=5
CHAT_USER_RATE_PER_MINUTE=20
VECTOR_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=8
RRF_K=60
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSIONS=1024
QDRANT_COLLECTION=finalweek_segments
OUTLINE_REQUEST_TIMEOUT_SECONDS=180
PLAN_REQUEST_TIMEOUT_SECONDS=60
CHAT_REQUEST_TIMEOUT_SECONDS=60
CHAT_HISTORY_LIMIT=20
MOCK_EXAM_USER_RATE_PER_MINUTE=3
MOCK_EXAM_REQUEST_TIMEOUT_SECONDS=240
MOCK_EXAM_MAX_QUESTIONS=50
MOCK_EXAM_MAX_SCORE=1000
MOCK_EXAM_MAX_DURATION_MINUTES=300
MOCK_EXAM_MAX_INSTRUCTION_LENGTH=2000
MOCK_EXAM_PAGE_SIZE=10
MOCK_EXAM_HISTORY_SIMILARITY_THRESHOLD=0.82
MOCK_EXAM_QUALITY_POLICY_VERSION=v1
MOCK_EXAM_CLEANUP_MAX_ATTEMPTS=8
MOCK_EXAM_CLEANUP_INTERVAL_SECONDS=30
XELATEX_EXECUTABLE=xelatex
XELATEX_COMPILE_TIMEOUT_SECONDS=60
MOCK_EXAM_PDF_MAX_SIZE_MB=20
XELATEX_MAX_LOG_SIZE_KB=512
MOCK_EXAM_TEMP_DIRECTORY=./data/tmp/mock-exams
MOCK_EXAM_TEMPLATE_VERSION=v2
MOCK_EXAM_FORMULA_POLICY_VERSION=v1

# Bailian (never commit a real key)
BAILIAN_API_KEY=
BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com
BAILIAN_ASR_MODEL=paraformer-realtime-v2
BAILIAN_OCR_MODEL=qwen-vl-ocr-latest
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_LLM_MODEL=qwen3.7-plus
BAILIAN_TIMEOUT_SECONDS=60
BAILIAN_MAX_ATTEMPTS=3

# Golden evaluation defaults
GOLDEN_CASE_COUNT=14
GOLDEN_COVERAGE_THRESHOLD=0.80
GOLDEN_CITATION_THRESHOLD=0.90
GOLDEN_UNGROUNDED_THRESHOLD=0.10
GOLDEN_MOCK_STRUCTURE_THRESHOLD=0.95
GOLDEN_MOCK_SOURCE_THRESHOLD=0.90
GOLDEN_MOCK_ANSWER_THRESHOLD=0.95
GOLDEN_MOCK_REPLICATION_THRESHOLD=0.00
GOLDEN_MOCK_PDF_THRESHOLD=0.95
